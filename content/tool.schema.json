{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
		},
		"kind": {
			"type": "string",
			"enum": [
				"tool",
				"framework",
				"directory",
				"guide"
			]
		},
		"section": {
			"type": "string",
			"pattern": "\\S"
		},
		"name": {
			"type": "string",
			"pattern": "\\S"
		},
		"url": {
			"type": "string",
			"pattern": "^https://"
		},
		"operator": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"pattern": "\\S"
				},
				"url": {
					"type": "string",
					"pattern": "^https://"
				}
			},
			"required": [
				"name"
			],
			"additionalProperties": false
		},
		"summary": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"pattern": "\\S"
				},
				"es": {
					"type": "string",
					"pattern": "\\S"
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"best_for": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"pattern": "\\S"
				},
				"es": {
					"type": "string",
					"pattern": "\\S"
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"targets": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"mode": {
			"type": "string",
			"pattern": "\\S"
		},
		"inputs": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"frameworks": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"output": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"pattern": "\\S"
				},
				"es": {
					"type": "string",
					"pattern": "\\S"
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"api": {
			"type": "object",
			"properties": {
				"available": {
					"type": "boolean"
				},
				"url": {
					"type": "string",
					"pattern": "^https://"
				}
			},
			"required": [
				"available"
			],
			"additionalProperties": false
		},
		"source_code": {
			"type": "string",
			"pattern": "^https://"
		},
		"self_hostable": {
			"type": "boolean"
		},
		"license": {
			"type": "string",
			"pattern": "\\S"
		},
		"status": {
			"type": "string",
			"pattern": "\\S"
		},
		"status_note": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"pattern": "\\S"
				},
				"es": {
					"type": "string",
					"pattern": "\\S"
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"last_verified": {
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
		},
		"references": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"title": {
						"type": "string",
						"pattern": "\\S"
					},
					"url": {
						"type": "string",
						"pattern": "^https://"
					}
				},
				"required": [
					"title",
					"url"
				],
				"additionalProperties": false
			}
		},
		"metrics": {
			"type": "object",
			"properties": {
				"checked": {
					"type": "string",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
				},
				"citations": {
					"minItems": 1,
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"label": {
								"type": "string",
								"pattern": "\\S"
							},
							"doi": {
								"type": "string",
								"pattern": "^10\\.\\d{4,9}\\/\\S+$"
							},
							"count": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							}
						},
						"required": [
							"label",
							"doi",
							"count"
						],
						"additionalProperties": false
					}
				},
				"github": {
					"type": "object",
					"properties": {
						"stars": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						"forks": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						"contributors": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						"last_push": {
							"type": "string",
							"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
						},
						"last_release": {
							"type": "object",
							"properties": {
								"tag": {
									"type": "string",
									"pattern": "\\S"
								},
								"date": {
									"type": "string",
									"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
								}
							},
							"required": [
								"tag",
								"date"
							],
							"additionalProperties": false
						}
					},
					"required": [
						"stars",
						"forks",
						"contributors",
						"last_push"
					],
					"additionalProperties": false
				},
				"downloads": {
					"minItems": 1,
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"source": {
								"type": "string",
								"enum": [
									"zenodo",
									"pypi"
								]
							},
							"record": {
								"type": "string",
								"pattern": "^\\d+$"
							},
							"package": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							},
							"count": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"period": {
								"type": "string",
								"enum": [
									"total",
									"last_30_days"
								]
							}
						},
						"required": [
							"source",
							"count",
							"period"
						],
						"additionalProperties": false
					}
				}
			},
			"required": [
				"checked"
			],
			"additionalProperties": false,
			"anyOf": [
				{
					"required": [
						"citations"
					]
				},
				{
					"required": [
						"github"
					]
				},
				{
					"required": [
						"downloads"
					]
				}
			]
		}
	},
	"required": [
		"id",
		"kind",
		"section",
		"name",
		"url",
		"operator",
		"summary",
		"status",
		"last_verified"
	],
	"additionalProperties": false,
	"allOf": [
		{
			"if": {
				"properties": {
					"kind": {
						"const": "tool"
					}
				},
				"required": [
					"kind"
				]
			},
			"then": {
				"required": [
					"targets",
					"mode",
					"inputs",
					"output"
				]
			}
		},
		{
			"if": {
				"properties": {
					"kind": {
						"const": "guide"
					}
				},
				"required": [
					"kind"
				]
			},
			"then": {
				"not": {
					"anyOf": [
						{
							"required": [
								"targets"
							]
						},
						{
							"required": [
								"mode"
							]
						},
						{
							"required": [
								"inputs"
							]
						},
						{
							"required": [
								"output"
							]
						}
					]
				}
			}
		}
	]
}
