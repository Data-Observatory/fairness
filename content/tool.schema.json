{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
		},
		"kind": {
			"type": "string",
			"enum": [
				"tool",
				"framework",
				"directory"
			]
		},
		"section": {
			"type": "string",
			"pattern": "\\S"
		},
		"name": {
			"type": "string",
			"pattern": "\\S"
		},
		"url": {
			"type": "string",
			"pattern": "^https://"
		},
		"operator": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"pattern": "\\S"
				},
				"url": {
					"type": "string",
					"pattern": "^https://"
				}
			},
			"required": [
				"name"
			],
			"additionalProperties": false
		},
		"summary": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"pattern": "\\S"
				},
				"es": {
					"type": "string",
					"pattern": "\\S"
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"best_for": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"pattern": "\\S"
				},
				"es": {
					"type": "string",
					"pattern": "\\S"
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"targets": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"mode": {
			"type": "string",
			"pattern": "\\S"
		},
		"inputs": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"frameworks": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"output": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"pattern": "\\S"
				},
				"es": {
					"type": "string",
					"pattern": "\\S"
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"api": {
			"type": "object",
			"properties": {
				"available": {
					"type": "boolean"
				},
				"url": {
					"type": "string",
					"pattern": "^https://"
				}
			},
			"required": [
				"available"
			],
			"additionalProperties": false
		},
		"source_code": {
			"type": "string",
			"pattern": "^https://"
		},
		"self_hostable": {
			"type": "boolean"
		},
		"license": {
			"type": "string",
			"pattern": "\\S"
		},
		"status": {
			"type": "string",
			"pattern": "\\S"
		},
		"status_note": {
			"type": "object",
			"properties": {
				"en": {
					"type": "string",
					"pattern": "\\S"
				},
				"es": {
					"type": "string",
					"pattern": "\\S"
				}
			},
			"required": [
				"en",
				"es"
			],
			"additionalProperties": {
				"type": "string",
				"pattern": "\\S"
			}
		},
		"last_verified": {
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
		},
		"references": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"title": {
						"type": "string",
						"pattern": "\\S"
					},
					"url": {
						"type": "string",
						"pattern": "^https://"
					}
				},
				"required": [
					"title",
					"url"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"id",
		"kind",
		"section",
		"name",
		"url",
		"operator",
		"summary",
		"status",
		"last_verified"
	],
	"additionalProperties": false,
	"allOf": [
		{
			"if": {
				"properties": {
					"kind": {
						"const": "tool"
					}
				},
				"required": [
					"kind"
				]
			},
			"then": {
				"required": [
					"targets",
					"mode",
					"inputs",
					"output"
				]
			}
		}
	]
}
